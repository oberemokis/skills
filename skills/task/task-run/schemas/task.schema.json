{
  "$comment": "Состояние одной задачи task-run. Проверяет scripts/check-json.mjs (подмножество JSON Schema). Поля описаны в state.md.",
  "type": "object",
  "required": [
    "schema", "project", "task", "title", "type", "level", "base", "delivery", "branch", "worktree",
    "fleet", "session", "stage", "stages", "context", "findings", "fixRounds", "pending", "outbound", "commit", "mrs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "task-run/task@1" },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "version": { "type": "string" }, "dir": { "type": "string" }, "sha": { "type": ["string", "null"] } }
    },
    "project": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "type": { "enum": ["feature", "bug"] },
    "level": { "enum": ["S", "M", "L"] },
    "levelReason": { "type": "string" },
    "base": { "type": "string", "minLength": 1 },
    "delivery": { "enum": ["mr", "push"] },
    "branch": { "type": "string", "minLength": 1 },
    "worktree": { "type": "string", "pattern": "^/" },
    "fleet": { "type": "boolean" },
    "session": {
      "type": "object",
      "required": ["agent", "workspace", "pane", "claudeSession"],
      "additionalProperties": false,
      "properties": {
        "agent": { "type": ["string", "null"] },
        "workspace": { "type": ["string", "null"] },
        "pane": { "type": ["string", "null"] },
        "claudeSession": { "type": ["string", "null"] }
      }
    },
    "stage": {
      "type": "object",
      "required": ["code", "status", "waiting", "since"],
      "additionalProperties": false,
      "properties": {
        "code": { "enum": ["start", "worktree", "plan", "ask-product", "implement", "verify", "review", "audit", "show", "deliver", "close"] },
        "status": { "enum": ["running", "waiting-user", "waiting-external", "blocked", "stopped", "done"] },
        "waiting": { "type": ["string", "null"] },
        "since": { "type": "string", "minLength": 1 }
      }
    },
    "stages": {
      "type": "object",
      "propertyNames": { "enum": ["start", "worktree", "plan", "ask-product", "implement", "verify", "review", "audit", "show", "deliver", "close"] },
      "additionalProperties": {
        "type": "object",
        "required": ["status", "at"],
        "additionalProperties": false,
        "properties": {
          "status": { "enum": ["pending", "running", "done", "skipped", "blocked", "stopped"] },
          "at": { "type": ["string", "null"] },
          "note": { "type": "string" }
        }
      }
    },
    "context": {
      "type": "object",
      "required": ["goal", "criteria", "cases", "decisions", "openQuestions", "epicDoc", "memory"],
      "additionalProperties": false,
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["case", "seam", "test"],
            "additionalProperties": false,
            "properties": {
              "case": { "type": "string", "minLength": 1 },
              "seam": { "type": "string", "minLength": 1 },
              "test": { "type": "string", "minLength": 1 }
            }
          }
        },
        "decisions": { "type": "array", "items": { "type": "string" } },
        "openQuestions": { "type": "array", "items": { "type": "string" } },
        "epicDoc": { "type": ["string", "null"] },
        "memory": { "type": "array", "items": { "type": "string" } }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "level", "text", "status"],
        "additionalProperties": false,
        "properties": {
          "source": { "enum": ["review", "audit", "show", "pipeline"] },
          "level": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "bug": { "type": "boolean" },
          "status": { "enum": ["open", "fixed", "accepted"] }
        }
      }
    },
    "hypothesis": { "type": ["string", "null"] },
    "fixRounds": { "type": "integer", "minimum": 0 },
    "cause": { "type": ["string", "null"] },
    "flag": {
      "type": "object",
      "required": ["value", "since"],
      "additionalProperties": false,
      "properties": { "value": { "type": "boolean" }, "since": { "type": ["string", "null"] } }
    },
    "pending": {
      "type": ["object", "null"],
      "required": ["action", "at"],
      "additionalProperties": false,
      "properties": { "action": { "type": "string", "minLength": 1 }, "at": { "type": "string", "minLength": 1 } }
    },
    "outbound": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "ref", "at"],
        "additionalProperties": false,
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reviewedDiff": { "type": ["string", "null"] },
    "commit": { "type": ["string", "null"] },
    "mrs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["iid"],
        "additionalProperties": false,
        "properties": {
          "iid": { "type": "integer", "minimum": 1 },
          "target": { "type": "string" },
          "state": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["stages"],
        "properties": { "stages": { "required": ["deliver"], "properties": { "deliver": { "properties": { "status": { "const": "done" } } } } } }
      },
      "then": { "properties": { "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" } } }
    },
    {
      "if": {
        "required": ["delivery", "stages"],
        "properties": {
          "delivery": { "const": "mr" },
          "stages": { "required": ["deliver"], "properties": { "deliver": { "properties": { "status": { "const": "done" } } } } }
        }
      },
      "then": { "properties": { "mrs": { "minItems": 1 } } }
    },
    {
      "if": {
        "required": ["stage"],
        "properties": { "stage": { "properties": { "status": { "enum": ["waiting-user", "waiting-external"] } } } }
      },
      "then": { "properties": { "stage": { "properties": { "waiting": { "type": "string", "minLength": 1 } } } } }
    }
  ]
}
